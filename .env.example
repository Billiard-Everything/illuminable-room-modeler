# Copy this file to `.env` for local development (`cp .env.example .env`,
# then fill in real values). For production, set these same variables in
# Render's dashboard instead — see DEPLOYMENT.md. Never commit a real `.env`
# file; `.gitignore` already excludes it.

# --- Database (server/db/pool.js) -------------------------------------------
# Use ONE of the two options below, not both.

# Option A: a single connection string — this is what you'll use in
# production (Supabase's "Connection string" from Project Settings >
# Database > Connection string > URI). SSL is enabled automatically for
# this option; set PGSSL=disable below to turn it off.
# DATABASE_URL=postgres://user:password@host:5432/postgres

# Option B: discrete fields — simplest for a local Postgres install on your
# own machine. SSL is disabled automatically for this option; set
# PGSSL=require below to turn it on.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=illuminable_room_modeler

# Override the automatic SSL choice above if you need to. Leave unset in
# the common case.
# PGSSL=require

# --- Server (server/api/start.js, server/api/app.js) ------------------------

# Port the API server listens on. Render sets PORT automatically in
# production — only set this yourself for local development, and only if
# port 8787 is already taken by something else.
# GRAPH_API_PORT=8787

# Comma-separated list of origins allowed to call this API (e.g. your
# GitHub Pages URL: https://your-username.github.io). Defaults to "*"
# (any origin) if unset, which is fine for local development but should be
# set explicitly once this is deployed for real.
# CORS_ORIGIN=https://your-username.github.io

# --- Frontend build (Vite — read by src/anglePlot/remoteGraphRepository.js) -
# This one is NOT read by the server; Vite reads it at *build* time for the
# browser bundle. Set it in your shell or a `.env` file in the project root
# before running `npm run build` for a real deployment; for local
# development it defaults to http://localhost:8787, so you can usually
# leave this unset.
# VITE_GRAPH_API_URL=https://your-api.onrender.com
